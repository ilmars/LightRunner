{
  "name": "light-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-based lighting app that lets volunteers run a church service with pre-built looks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ilmars/LightRunner.git"
  },
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/src/main.ts",
    "dev": "node --watch server/src/main.ts",
    "test": "node --test \"packages/*/test/*.test.ts\" \"server/test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "jump-check": "node tools/jump-check.ts",
    "timing-probe": "node tools/timing-probe.ts",
    "service": "node server/src/supervise.ts"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "zod": "^4.1.0"
  },
  "optionalDependencies": {
    "@julusian/midi": "^3.8.1",
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "typescript": "^5.9.0"
  }
}
